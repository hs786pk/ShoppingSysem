@page "/buyer"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Customer,Admin")]

@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using ShoppingSysem.Data
@using ShoppingSysem.Models
@using ShoppingSysem.Services

@inject AuthenticationStateProvider AuthProvider
@inject IRecommendationService Recommender
@inject IOrderService Orders
@inject ApplicationDbContext Db

<PageTitle>Shop</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Welcome, shopper</h2>
    <a class="btn btn-outline-primary btn-sm" href="/buyer/orders">My orders</a>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-6">
        <input class="form-control" placeholder="Search products..." @bind="search" @bind:event="oninput" />
    </div>
    <div class="col-md-6">
        <select class="form-select" @bind="selectedCategory">
            <option value="">All categories</option>
            @foreach (var c in categories)
            {
                <option value="@c">@c</option>
            }
        </select>
    </div>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert @(messageIsError ? "alert-danger" : "alert-success") py-2">@message</div>
}

@if (recommended.Count > 0 && string.IsNullOrWhiteSpace(search) && string.IsNullOrEmpty(selectedCategory))
{
    <h4 class="mt-4">Recommended for you</h4>
    <div class="row">
        @foreach (var r in recommended)
        {
            <div class="col-sm-6 col-lg-3 mb-3">
                <div class="card h-100 border-primary">
                    <div class="card-body">
                        <span class="badge bg-primary mb-2">@r.Reason</span>
                        <h5 class="card-title">@r.Item.Name</h5>
                        <p class="text-muted mb-1">@(r.Item.Category ?? "General")</p>
                        <p class="fw-bold mb-1">Rs @r.Item.Price.ToString("N0")</p>
                        <p class="mb-0 @(r.Item.Stock > 0 ? "text-success" : "text-danger")">
                            @(r.Item.Stock > 0 ? $"{r.Item.Stock} in stock" : "Out of stock")
                        </p>
                    </div>
                    <div class="card-footer d-flex gap-2">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => Act(r.Item, InteractionType.View)">View</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Act(r.Item, InteractionType.Wishlist)">Save</button>
                        <button class="btn btn-sm btn-success ms-auto"
                                disabled="@(busy || r.Item.Stock <= 0)"
                                @onclick="() => Buy(r.Item)">
                            Buy
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

<h4 class="mt-4">All products</h4>
@if (filtered.Count == 0)
{
    <p class="text-muted">No products found.</p>
}
else
{
    <div class="row">
        @foreach (var item in filtered)
        {
            <div class="col-sm-6 col-lg-3 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@item.Name</h5>
                        <p class="text-muted mb-1">@(item.Category ?? "General")</p>
                        <p class="fw-bold mb-1">Rs @item.Price.ToString("N0")</p>
                        <p class="mb-0 @(item.Stock > 0 ? "text-success" : "text-danger")">
                            @(item.Stock > 0 ? $"{item.Stock} in stock" : "Out of stock")
                        </p>
                    </div>
                    <div class="card-footer d-flex gap-2">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => Act(item, InteractionType.View)">View</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Act(item, InteractionType.Wishlist)">Save</button>
                        <button class="btn btn-sm btn-success ms-auto"
                                disabled="@(busy || item.Stock <= 0)"
                                @onclick="() => Buy(item)">
                            Buy
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private string userId = string.Empty;
    private string search = string.Empty;
    private string selectedCategory = string.Empty;
    private string? message;
    private bool messageIsError;
    private bool busy;

    private List<Item> allItems = new();
    private List<string> categories = new();
    private List<ScoredItem> recommended = new();

    private IEnumerable<Item> FilteredQuery =>
        allItems.Where(i =>
            (string.IsNullOrWhiteSpace(search) ||
                i.Name.Contains(search, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(selectedCategory) ||
                string.Equals(i.Category ?? "General", selectedCategory, StringComparison.OrdinalIgnoreCase)));

    private List<Item> filtered => FilteredQuery.ToList();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;

        await ReloadItems();
        await LoadRecommendations();
    }

    private async Task ReloadItems()
    {
        allItems = await Db.Items.AsNoTracking().OrderBy(i => i.Name).ToListAsync();
        categories = allItems
            .Select(i => i.Category ?? "General")
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(c => c)
            .ToList();
    }

    private async Task LoadRecommendations()
    {
        recommended = await Recommender.GetRecommendationsAsync(userId, 8);
    }

    private async Task Act(Item item, InteractionType type)
    {
        if (string.IsNullOrEmpty(userId)) return;

        await Recommender.RecordAsync(userId, item.Id, type);

        messageIsError = false;
        message = type switch
        {
            InteractionType.Wishlist => $"{item.Name} saved.",
            _ => $"Viewing {item.Name}."
        };

        await LoadRecommendations();
    }

    private async Task Buy(Item item)
    {
        if (busy || string.IsNullOrEmpty(userId) || item.Stock <= 0) return;

        busy = true;
        try
        {
            var result = await Orders.PlaceAsync(userId, item.Id, 1);
            message = result.Message;
            messageIsError = !result.Ok;

            await ReloadItems();
            await LoadRecommendations();
        }
        finally
        {
            busy = false;
        }
    }
}