@page "/buyer"
@rendermode InteractiveServer
@attribute [Authorize(Roles = $"{AppRoles.Customer},{AppRoles.Admin}")]

<PageTitle>Shop</PageTitle>

<header class="mast">
    <p class="kicker">The floor</p>
    <h1>Shop the houses.</h1>
    <p class="dek">One price in rupees, live stock, and a short list built from what you view, save, and buy.</p>
</header>

<div class="finder">
    <input placeholder="Find a product" @bind="search" @bind:event="oninput" />
    <select @bind="selectedCategory">
        <option value="">All categories</option>
        @foreach (var c in categories)
        {
            <option value="@c">@c</option>
        }
    </select>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert @(messageIsError ? "alert-danger" : "alert-success")">@message</div>
}

@if (recommended.Count > 0 && string.IsNullOrWhiteSpace(search) && string.IsNullOrEmpty(selectedCategory))
{
    <section class="shelf">
        <div class="shelf-head">
            <h2>Set aside for you</h2>
            <span>@recommended.Count picks</span>
        </div>
        <div class="catalog shelf-picked">
            @foreach (var piece in RecommendedPieces)
            {
                <BuyerItemPiece Item="piece.Item" Reason="piece.Reason" Index="piece.Index" Busy="busy" OnView="RecordView" OnSave="RecordSave" OnBuy="PlaceOrder" />
            }
        </div>
    </section>
}

<section class="shelf">
    <div class="shelf-head">
        <h2>Everything on the floor</h2>
        <a href="/buyer/orders">My orders</a>
    </div>
    @if (filtered.Count == 0)
    {
        <p class="text-muted">Nothing matches.</p>
    }
    else
    {
        <div class="catalog">
            @foreach (var piece in FloorPieces)
            {
                <BuyerItemPiece Item="piece.Item" Reason="piece.Reason" Index="piece.Index" Busy="busy" OnView="RecordView" OnSave="RecordSave" OnBuy="PlaceOrder" />
            }
        </div>
    }
</section>
