@page "/buyer/orders"
@rendermode InteractiveServer
@attribute [Authorize(Roles = $"{AppRoles.Customer},{AppRoles.Admin}")]

@using ShoppingSysem.Models
@using ShoppingSysem.Services

@inject AuthenticationStateProvider AuthProvider
@inject IOrderService Orders

<PageTitle>My orders</PageTitle>

<header class="mast">
    <p class="kicker">Your slips</p>
    <h1>What you bought.</h1>
    <p class="dek">A placed order can still be cancelled. Fulfilled ones stay on the books.</p>
</header>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert @(messageIsError ? "alert-danger" : "alert-success")">@message</div>
}

@if (orders.Count == 0)
{
    <p class="text-muted">You have not bought anything yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Shop</th>
                <th>Item</th>
                <th>Qty</th>
                <th>Total</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in orders)
            {
                <tr>
                    <td>@order.OrderedAt.ToLocalTime().ToString("g")</td>
                    <td>@order.Shop.Name</td>
                    <td>@order.Item.Name</td>
                    <td>@order.Quantity</td>
                    <td>Rs. @order.TotalPrice.ToString("N0")</td>
                    <td><span class="status status-@order.Status.ToString().ToLowerInvariant()">@order.Status</span></td>
                    <td>
                        @if (order.Status == OrderStatus.Placed)
                        {
                            <button class="btn btn-outline-danger" disabled="@busy" @onclick="() => Cancel(order.Id)">Cancel</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

