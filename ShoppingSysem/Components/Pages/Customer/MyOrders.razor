@page "/buyer/orders"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Customer,Admin")]

@using System.Security.Claims
@using ShoppingSysem.Models
@using ShoppingSysem.Services

@inject AuthenticationStateProvider AuthProvider
@inject IOrderService Orders

<PageTitle>My orders</PageTitle>

<h3>My orders</h3>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert @(messageIsError ? "alert-danger" : "alert-success") py-2">@message</div>
}

@if (orders.Count == 0)
{
    <p class="text-muted">You have not bought anything yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Shop</th>
                <th>Item</th>
                <th>Qty</th>
                <th>Total</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in orders)
            {
                <tr>
                    <td>@order.OrderedAt.ToLocalTime().ToString("g")</td>
                    <td>@order.Shop.Name</td>
                    <td>@order.Item.Name</td>
                    <td>@order.Quantity</td>
                    <td>Rs. @order.TotalPrice.ToString("N0")</td>
                    <td>@order.Status</td>
                    <td>
                        @if (order.Status == OrderStatus.Placed)
                        {
                            <button class="btn btn-sm btn-outline-danger" disabled="@busy" @onclick="() => Cancel(order.Id)">Cancel</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private string userId = string.Empty;
    private string? message;
    private bool messageIsError;
    private bool busy;
    private List<Order> orders = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        await Reload();
    }

    private async Task Reload()
    {
        if (string.IsNullOrEmpty(userId)) return;
        orders = await Orders.GetForCustomerAsync(userId);
    }

    private async Task Cancel(int orderId)
    {
        if (busy || string.IsNullOrEmpty(userId)) return;
        busy = true;
        try
        {
            var result = await Orders.CancelByCustomerAsync(userId, orderId);
            message = result.Message;
            messageIsError = !result.Ok;
            await Reload();
        }
        finally
        {
            busy = false;
        }
    }
}