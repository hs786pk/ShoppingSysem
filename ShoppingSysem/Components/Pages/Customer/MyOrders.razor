@page "/buyer/orders"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Customer,Admin")]

@using System.Security.Claims
@using ShoppingSysem.Models
@using ShoppingSysem.Services

@inject AuthenticationStateProvider AuthProvider
@inject IOrderService Orders

<PageTitle>My orders</PageTitle>

<h3>My orders</h3>

@if (orders.Count == 0)
{
    <p class="text-muted">You have not bought anything yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Shop</th>
                <th>Item</th>
                <th>Qty</th>
                <th>Total</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in orders)
            {
                <tr>
                    <td>@order.OrderedAt.ToLocalTime().ToString("g")</td>
                    <td>@order.Shop.Name</td>
                    <td>@order.Item.Name</td>
                    <td>@order.Quantity</td>
                    <td>Rs. @order.TotalPrice.ToString("N0")</td>
                    <td>@order.Status</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Order> orders = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        if (string.IsNullOrEmpty(userId)) return;

        orders = await Orders.GetForCustomerAsync(userId);
    }
}