@page "/shopkeeper"
@attribute [Authorize(Roles = "Shopkeeper")]
@using Microsoft.AspNetCore.Authorization

<PageTitle>Shopkeeper Dashboard</PageTitle>

<header class="mast">
    <p class="kicker">Shopkeeper</p>
    <h1>Today's till.</h1>
    <p class="dek">A counter sale is not a customer order. The two books stay separate.</p>
</header>

<nav class="ledger">
    <a class="ledger-row" href="/shopkeeper/sale">
        <span class="kicker">01</span>
        <span><strong>Make a sale</strong><em>Walk-in quantity off your own stock.</em></span>
        <span class="go">Open</span>
    </a>
    <a class="ledger-row" href="/shopkeeper/history">
        <span class="kicker">02</span>
        <span><strong>Sales history</strong><em>What you rang up, and the revenue.</em></span>
        <span class="go">Open</span>
    </a>
    <a class="ledger-row" href="/shopkeeper/orders">
        <span class="kicker">03</span>
        <span><strong>Customer orders</strong><em>Fulfill, or cancel and return the stock.</em></span>
        <span class="go">Open</span>
    </a>
</nav>
