@page "/shopkeeper/products"
@attribute [Authorize(Roles = AppRoles.Shopkeeper)]
@rendermode InteractiveServer

<PageTitle>My products</PageTitle>

<header class="mast">
    <p class="kicker">Your shelves</p>
    <h1>My products.</h1>
    <p class="dek">Drafts, approvals and live listings for the shops you stand in.</p>
</header>

<p><a class="btn btn-primary" href="/shopkeeper/products/new">New product</a></p>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert @(messageIsError ? "alert-danger" : "alert-success")">@message</div>
}

@if (products.Count == 0)
{
    <p class="text-muted">You have no products yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th></th>
                <th>Product</th>
                <th>Shop</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Status</th>
                <th>Updated</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in products)
            {
                <tr>
                    <td>
                        @if (ThumbUrl(item) is { } url)
                        {
                            <img src="@url" alt="@item.Name" width="56" height="56" style="object-fit:cover;" />
                        }
                    </td>
                    <td>
                        <strong>@item.Name</strong><br />
                        <span class="meta">@item.SKU</span>
                    </td>
                    <td>@item.Shop.Name</td>
                    <td>Rs. @item.Price.ToString("N0")</td>
                    <td>@item.Stock</td>
                    <td>
                        <span class="status @StatusClass(item)">@StatusLabel(item)</span>
                        @if (!string.IsNullOrEmpty(item.RejectionReason))
                        {
                            <br /><span class="meta">@item.RejectionReason</span>
                        }
                    </td>
                    <td>@item.UpdatedAt.ToLocalTime().ToString("g")</td>
                    <td>
                        <div style="display:flex; flex-wrap:wrap; gap:0.5rem;">
                            @if (CanEdit(item))
                            {
                                <a class="btn btn-sm btn-secondary" href="/shopkeeper/products/@item.Id">Edit</a>
                            }
                            @if (CanSubmit(item))
                            {
                                <button class="btn btn-sm btn-primary" disabled="@busy" @onclick="() => Submit(item.Id)">Submit</button>
                            }
                            @if (CanDeactivate(item))
                            {
                                <button class="btn btn-sm btn-secondary" disabled="@busy" @onclick="() => Deactivate(item.Id)">Deactivate</button>
                            }
                            @if (CanReactivate(item))
                            {
                                <button class="btn btn-sm btn-secondary" disabled="@busy" @onclick="() => Reactivate(item.Id)">Reactivate</button>
                            }
                            @if (pendingDeleteId == item.Id)
                            {
                                <button class="btn btn-sm btn-danger" disabled="@busy" @onclick="() => ConfirmDelete(item.Id)">Yes, delete</button>
                                <button class="btn btn-sm btn-secondary" @onclick="CancelDelete">Cancel</button>
                            }
                            else
                            {
                                <button class="icon-btn-danger" title="Delete product" @onclick="() => RequestDelete(item.Id)">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M3 6h18" />
                                        <path d="M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2" />
                                        <path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6" />
                                        <path d="M10 11v6M14 11v6" />
                                    </svg>
                                </button>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}